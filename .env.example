# Copy to .env for local overrides. Never put credentials in a tracked file.
PG_CPUS=2.0
PG_MEMORY=1g
PG_SHARED_BUFFERS=128MB
PG_SHM_SIZE=256m
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=0
K6_VUS=10
K6_DURATION=30s
CUSTOMER_COUNT=10000
ORDER_LIMIT=20
# Only on hosts without cgroup support: PG_CPUS=0 and PG_MEMORY=0 disable limits.

# Phases 2-4: ordinary web defaults stay on the direct admin development connection.
PG_MAX_CONNECTIONS=100
DB_POOL=5
DB_CHECKOUT_TIMEOUT=2
LAB_EXPERIMENT_ENDPOINTS=0
PGBOUNCER_POOL_SIZE=4

# Optional horizontal-scaling nodes (each node, not a shared aggregate budget):
SHARD_CPUS=1.0
SHARD_MEMORY=512m
# Set both to 0 explicitly only on hosts without usable cgroup support.
